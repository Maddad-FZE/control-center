DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.40,zaidan.home
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://192.168.0.40:8099,https://ai.thezaidan.family
SESSION_COOKIE_DOMAIN=
HEALTH_CHECK_ENABLED=true
DOCKER_HOST=unix:///var/run/docker.sock
NTFY_URL=http://192.168.0.40:8090
NTFY_TOPIC=homelab-alerts
NTFY_USER=daher
NTFY_PASSWORD=
SITE_TITLE=Home Server Command Center
GITHUB_REPO=Maddad-FZE/control-center
