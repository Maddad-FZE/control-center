# GITHUB_TOKEN=
UPDATE_CHECK_INTERVAL_HOURS=12
UPDATES_ALLOW_INSTALL=true
UPDATE_RESTART_COMMAND=docker restart control-center
SERVICES_HOST=192.168.0.40
